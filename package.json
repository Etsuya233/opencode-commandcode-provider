{
  "name": "@etsuya/opencode-commandcode-provider",
  "version": "0.1.0",
  "description": "Unofficial Command Code provider for opencode \u2014 Provider API, live model catalog, zero runtime dependencies",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Etsuya233/opencode-commandcode-provider.git"
  },
  "homepage": "https://github.com/Etsuya233/opencode-commandcode-provider#readme",
  "bugs": {
    "url": "https://github.com/Etsuya233/opencode-commandcode-provider/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "commandcode-models": "./dist/bin/commandcode-models.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "sync": "node scripts/sync-catalog.ts",
    "sync:check": "node scripts/sync-catalog.ts --check",
    "readme": "node scripts/generate-readme.ts",
    "smoke": "node scripts/smoke-opencode.ts",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "opencode",
    "opencode-provider",
    "opencode-plugin",
    "commandcode",
    "command-code",
    "llm"
  ],
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.32",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
